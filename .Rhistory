fcst_results_jan25
all_data_jan25 <- rbind(gas_national_average, fcst_results_jan25[, c("value", "date", "forecast")]) %>%
mutate(dollars= round(value, 2), color_val=case_when(
forecast == 0 ~ "Actual",
forecast == 1 ~ "Forecast",
forecast == 2 ~ "Testing"
))
plot_jan25 <- ggplot(all_data_jan25)+
geom_line(aes(x=date, y=dollars, group=color_val, color=color_val,
text = paste("Month:", format(date, "%Y-%m"), "<br>Dollars:", dollars)),linewidth = 0.75)+
scale_y_continuous(limits=c(0, NA))+
scale_x_date(date_breaks = "1 years", date_labels = "%Y") +
theme_minimal()+
labs(title="National Average Gas Forecast: June 2024 Version", x="", y="Dollars", color="")
ggplotly(p = plot_jan25,tooltip = "text")
plot_jan25 <- ggplot(all_data_jan25)+
geom_line(aes(x=date, y=dollars, group=color_val, color=color_val,
text = paste("Month:", format(date, "%Y-%m"), "<br>Dollars:", dollars)),linewidth = 0.75)+
